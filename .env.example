# SwingArena Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# =============================================================================
# LLM API (OpenAI-compatible endpoint for agent_battle.py)
# =============================================================================

# Base URL of the LLM API (must be OpenAI-compatible)
# Examples:
#   - OpenAI:        https://api.openai.com/v1
#   - DashScope:     https://dashscope.aliyuncs.com/compatible-mode/v1
#   - Local vLLM:    http://localhost:8000/v1
LLM_BASE_URL=https://api.openai.com/v1

# API key for the LLM endpoint
LLM_API_KEY=sk-xxx

# Model name (must be available at the endpoint above)
LLM_MODEL=gpt-4

# Tokenizer for token counting (HuggingFace model name or local path)
# Use "gpt2" for OpenAI models, or match the model family for others
LLM_TOK_MODEL=gpt2

# =============================================================================
# API Keys (for inference / collect modules, optional for agent_battle)
# =============================================================================

# OpenAI API Key (for swingarena.inference.run_api with GPT models)
# OPENAI_API_KEY=sk-xxx

# Anthropic API Key (for Claude models)
# ANTHROPIC_API_KEY=sk-ant-xxx

# GitHub Personal Access Token (for collect module and repo operations)
# GITHUB_TOKEN=ghp_xxx

# Multiple GitHub tokens for parallel data collection (comma-separated)
# GITHUB_TOKENS=ghp_token1,ghp_token2,ghp_token3

# =============================================================================
# SwingArena Paths
# =============================================================================

# Temporary workspace for CI evaluation runs
SWING_TESTBED_PATH=/path/to/testbed

# Directory containing cloned repositories
SWING_REPOS_DIR_PATH=/path/to/repos

# Directory containing BM25 search indexes (built by prepare module)
SWING_INDEXES_PATH=/path/to/indexes

# =============================================================================
# CI/CD Configuration
# =============================================================================

# CI tool for running tests: "act" (local GitHub Actions) or "cargo" (Rust only)
CI_TOOL_NAME=act

# Act timeout in seconds (for matrix jobs with many combinations, 30min default may be too short)
# 7200 = 2 hours
ACT_TIMEOUT_SECONDS=7200

# =============================================================================
# Java / JVM (required by pyserini for BM25 retrieval)
# =============================================================================

# Set this if Java is not auto-detected (needs JDK 21+)
# JAVA_HOME=/path/to/jdk-21

# Direct path to libjvm.so (overrides JAVA_HOME; used by pyjnius)
# JVM_PATH=/usr/lib/jvm/java-21-openjdk-amd64/lib/server/libjvm.so

# =============================================================================
# Git Identity (required for commit/patch operations during battle)
# =============================================================================

# Git author/committer identity used when applying patches to repos.
# If not set, git may refuse to commit in clean environments.
GIT_AUTHOR_NAME=SwingBench
GIT_AUTHOR_EMAIL=swingbench@local
GIT_COMMITTER_NAME=SwingBench
GIT_COMMITTER_EMAIL=swingbench@local
